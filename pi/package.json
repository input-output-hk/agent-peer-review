{
  "name": "@input-output-hk/agent-review-pi",
  "version": "0.5.0",
  "description": "pi.dev integration for the agent peer-review workflow (extension + skill).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "files": ["dist", "skills", "taskflows"],
  "keywords": ["pi-package"],
  "publishConfig": { "registry": "https://npm.pkg.github.com" },
  "pi": { "extensions": ["./dist/extension.js"], "skills": ["./skills"] },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": { "@input-output-hk/agent-review": "^0.5.0" },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.83.0",
    "typebox": "^1.3.9",
    "pi-taskflow": ">=0.2.8"
  },
  "peerDependenciesMeta": {
    "pi-taskflow": { "optional": true }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "typebox": "^1.3.9",
    "typescript": "^5.5.0",
    "vitest": "^3.2.6"
  }
}
