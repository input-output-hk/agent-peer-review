{
  "name": "@input-output-hk/agent-review",
  "version": "0.5.0",
  "description": "Minimal asynchronous PR-review workflow over GitHub for Claude, Codex, and pi.dev agents.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "pi",
    "dashboard",
    "."
  ],
  "bin": {
    "agent-review": "dist/cli/index.js",
    "agent-review-mcp": "dist/mcp/index.js"
  },
  "files": [
    "dist",
    "skills",
    "schemas"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "pretest": "npm run typecheck:test",
    "test": "vitest run",
    "gen:schemas": "tsx scripts/gen-schemas.ts",
    "check:schemas": "tsx scripts/gen-schemas.ts && git diff --exit-code -- schemas",
    "check:lockfile": "tsx scripts/check-lockfile.ts",
    "check:version": "tsx scripts/version.ts --check",
    "version:set": "tsx scripts/version.ts",
    "changelog:release": "tsx scripts/changelog.ts release",
    "serve": "node dist/mcp/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@octokit/plugin-retry": "^7.0.0",
    "@octokit/plugin-throttling": "^10.0.0",
    "@octokit/rest": "^21.0.0",
    "commander": "^12.0.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/semver": "^7.5.0",
    "js-yaml": "^4.1.0",
    "semver": "^7.6.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.6"
  }
}
