{
  "name": "@input-output-hk/agent-review-dashboard",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agent-review-dashboard": "dist/cli.js"
  },
  "files": [
    "dist",
    "public"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "pretest": "npm run typecheck:test",
    "test": "vitest run",
    "dev": "vite"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/static": "^8.0.0",
    "@fontsource/barlow": "^5.1.0",
    "@input-output-hk/agent-review": "^0.3.0",
    "better-sqlite3": "12.9.0",
    "commander": "^12.0.0",
    "dompurify": "^3.1.6",
    "fastify": "^5.2.0",
    "markdown-it": "^14.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/markdown-it": "^14.1.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^25.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.6"
  }
}
